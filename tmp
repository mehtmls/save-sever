            DWORD64 start = GetTickCount64();

            ProcessInput();
            Update();
            Render();

            DWORD64 end = GetTickCount64();
            DWORD64 elapsed = end - start;
            if (elapsed < FRAME_DELAY_MS)
                Sleep(FRAME_DELAY_MS - elapsed);
        }
        ShowGameOver();
    }

private:
    enum class Direction
    {
        UP,
        DOWN,
        LEFT,
        RIGHT
    };

    struct Position
    {
        int x, y;
        Position(int x = 0, int y = 0) : x(x), y(y) {}
        bool operator==(const Position &o) const { return x == o.x && y == o.y; }

        struct Hash
        {
            size_t operator()(const Position &p) const
            {
                return hash<int>()(p.x) ^ (hash<int>()(p.y) << 1);
            }
        };
    };

    // 遊戲配置
    static constexpr int MAP_WIDTH = 40;
    static constexpr int MAP_HEIGHT = 20;
    static constexpr int FRAME_DELAY_MS = 120;
    static constexpr int INIT_LENGTH = 4;

    // 遊戲狀態
    deque<Position> snake;
    unordered_set<Position, Position::Hash> snakePositions;
    Position food;
    int score;
    bool gameOver;
    Direction dir;
    Direction nextDir;

    // 雙緩衝
    HANDLE hScreen[2];
    int activeScreen;

private:
    void InitGame()
    {
        snake.clear();
        snakePositions.clear();

        int startX = MAP_WIDTH / 4;
        int startY = MAP_HEIGHT / 2;
        for (int i = 0; i < INIT_LENGTH; ++i)
        {
            Position s(startX + i, startY);
            snake.push_back(s);
            snakePositions.insert(s);
        }

        dir = nextDir = Direction::LEFT;
        score = 0;
        gameOver = false;

        // 初始化雙緩衝
        hScreen[0] = CreateConsoleScreenBuffer(GENERIC_READ | GENERIC_WRITE, 0, NULL, CONSOLE_TEXTMODE_BUFFER, NULL);
        hScreen[1] = CreateConsoleScreenBuffer(GENERIC_READ | GENERIC_WRITE, 0, NULL, CONSOLE_TEXTMODE_BUFFER, NULL);
        activeScreen = 0;

        CONSOLE_CURSOR_INFO cursorInfo{1, FALSE};
        SetConsoleCursorInfo(hScreen[0], &cursorInfo);
        SetConsoleCursorInfo(hScreen[1], &cursorInfo);

        GenerateFood();
    }

    void ProcessInput()
    {
        if (_kbhit())
        {
            int ch = _getch();
            switch (ch)
            {
            case 72:
                if (dir != Direction::DOWN)
                    nextDir = Direction::UP;
                break;
            case 80:
                if (dir != Direction::UP)
                    nextDir = Direction::DOWN;
                break;
            case 75:
                if (dir != Direction::RIGHT)
                    nextDir = Direction::LEFT;
                break;
            case 77:
                if (dir != Direction::LEFT)
                    nextDir = Direction::RIGHT;
                break;
            case 27:
            case 32:
                gameOver = true;
                break;
            }
        }
    }

    void Update()
    {
        dir = nextDir;
        Position newHead = snake.front();
        switch (dir)
        {
        case Direction::UP:
            newHead.y--;
            break;
        case Direction::DOWN:
            newHead.y++;
            break;
        case Direction::LEFT:
            newHead.x--;
            break;
        case Direction::RIGHT:
            newHead.x++;
            break;
        }

        // 穿牆
        if (newHead.x < 0)
            newHead.x = MAP_WIDTH - 1;
        if (newHead.x >= MAP_WIDTH)
            newHead.x = 0;
        if (newHead.y < 0)
            newHead.y = MAP_HEIGHT - 1;
        if (newHead.y >= MAP_HEIGHT)
            newHead.y = 0;

        if (snakePositions.find(newHead) != snakePositions.end())
        {
            gameOver = true;
            return;
        }

        snake.push_front(newHead);
        snakePositions.insert(newHead);

        if (newHead == food)
        {
            score += 10;
            GenerateFood();
        }
        else
        {
            Position tail = snake.back();
            snake.pop_back();
            snakePositions.erase(tail);
        }
    }

    void GenerateFood()
    {
        do
        {
            food.x = rand() % MAP_WIDTH;
            food.y = rand() % MAP_HEIGHT;
        } while (snakePositions.find(food) != snakePositions.end());
    }

    void Render()
    {
        HANDLE hOut = hScreen[activeScreen];
        DWORD written;
        COORD coord{0, 0};
        SetConsoleCursorPosition(hOut, coord);

        // 使用寬字串緩衝重繪整個畫面
        wstring buffer;
        buffer.reserve((MAP_WIDTH + 3) * (MAP_HEIGHT + 5));

        buffer += L'＋';
        buffer.append(MAP_WIDTH, L'－');
        buffer += L"＋\n";

        for (int y = 0; y < MAP_HEIGHT; ++y)
        {
            buffer += L'｜';
            for (int x = 0; x < MAP_WIDTH; ++x)
            {
                Position pos(x, y);
                if (pos == food)
                    buffer += L'＊';
                else if (pos == snake.front())
                    buffer += L'＠';
                else if (snakePositions.find(pos) != snakePositions.end())
                    buffer += L'Ｏ';
                else
                    buffer += L'　'; // 全形空白
            }
            buffer += L"｜\n";
        }

        buffer += L'＋';
        buffer.append(MAP_WIDTH, L'－');
        buffer += L"＋\n";

        buffer += L"Score: " + std::to_wstring(score) + L"\n";
        buffer += L"Controls: Arrow keys to move, Space/Esc to quit\n";

        // 寬字輸出
        WriteConsoleW(hOut, buffer.c_str(), (DWORD)buffer.size(), &written, NULL);

        // 顯示當前緩衝區
        SetConsoleActiveScreenBuffer(hOut);

        // 切換緩衝區
        activeScreen = 1 - activeScreen;
    }

    void ShowGameOver()
    {
        HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
        SetConsoleActiveScreenBuffer(hOut);
        system("cls");
        print("\n\n   GAME OVER!");
        print("   Final Score: " + score);
        print("   Press any key to exit...");
        _getch();
    }
};

