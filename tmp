#define SE_DEBUG_PRIVILEGE L"SeDebugPrivilege"
#define SE_IMPERSONATE_PRIVILEGE L"SeImpersonatePrivilege"
#define SERVICE_NAME L"TrustedInstaller"

class TrustedInstallerLauncher
{
private:
    HMODULE hNtDll;
    NT_IMPERSONATE_THREAD NtImpersonateThread;

public:
    TrustedInstallerLauncher() : hNtDll(nullptr), NtImpersonateThread(nullptr)
    {
        // 加载 NT DLL
        hNtDll = LoadLibraryW(L"ntdll.dll");
        if (hNtDll)
        {
            NtImpersonateThread = (NT_IMPERSONATE_THREAD)GetProcAddress(hNtDll, "NtImpersonateThread");
        }
    }

    ~TrustedInstallerLauncher()
    {
        if (hNtDll)
        {
            FreeLibrary(hNtDll);
        }
    }

    // 启用特权
    BOOL EnablePrivilege(HANDLE hToken, LPCWSTR privilegeName)
    {
        LUID luid;
        if (!LookupPrivilegeValueW(nullptr, privilegeName, &luid))
        {
            return FALSE;
        }

        TOKEN_PRIVILEGES tp;
        tp.PrivilegeCount = 1;
        tp.Privileges[0].Luid = luid;
        tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;

        return AdjustTokenPrivileges(hToken, FALSE, &tp, sizeof(tp), nullptr, nullptr);
    }

    // 按进程名查找进程ID
    DWORD FindProcessByName(LPCWSTR processName)
    {
        HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
        if (hSnapshot == INVALID_HANDLE_VALUE)
        {
            return 0;
        }

        PROCESSENTRY32W pe;
        pe.dwSize = sizeof(pe);

        if (Process32FirstW(hSnapshot, &pe))
        {
            do
            {
                if (_wcsicmp(pe.szExeFile, processName) == 0)
                {
                    CloseHandle(hSnapshot);
                    return pe.th32ProcessID;
                }
            } while (Process32NextW(hSnapshot, &pe));
        }

        CloseHandle(hSnapshot);
        return 0;
    }

    // 获取进程的第一个线程ID
    DWORD GetFirstThreadId(DWORD pid)
    {
        HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
        if (hSnapshot == INVALID_HANDLE_VALUE)
        {
            return 0;
        }

        THREADENTRY32 te;
        te.dwSize = sizeof(te);

        if (Thread32First(hSnapshot, &te))
        {
            do
            {
                if (te.th32OwnerProcessID == pid)
                {
                    CloseHandle(hSnapshot);
                    return te.th32ThreadID;
                }
            } while (Thread32Next(hSnapshot, &te));
        }

        CloseHandle(hSnapshot);
        return 0;
    }

    // 启动 TrustedInstaller 服务
    BOOL StartTrustedInstallerService()
    {
        SC_HANDLE hSCM = OpenSCManagerW(nullptr, nullptr, SC_MANAGER_ALL_ACCESS);
        if (!hSCM)
        {
            return FALSE;
        }

        SC_HANDLE hService = OpenServiceW(hSCM, SERVICE_NAME, SERVICE_START);
        if (!hService)
        {
            CloseServiceHandle(hSCM);
            return FALSE;
        }

        BOOL success = StartServiceW(hService, 0, nullptr);
        DWORD error = GetLastError();

        // 忽略服务已运行的错误
        if (!success && error != ERROR_SERVICE_ALREADY_RUNNING)
        {
            CloseServiceHandle(hService);
            CloseServiceHandle(hSCM);
            print(L"服务已运行");
            return FALSE;
        }

        CloseServiceHandle(hService);
        CloseServiceHandle(hSCM);
        return TRUE;
    }

    // 等待服务启动并获取进程ID
    DWORD WaitForTrustedInstallerService()
    {
        // 连续监控服务状态
        SC_HANDLE hSCM = OpenSCManagerW(nullptr, nullptr, SC_MANAGER_CONNECT);
        if (!hSCM)
            return 0;

        SC_HANDLE hService = OpenServiceW(hSCM, SERVICE_NAME, SERVICE_QUERY_STATUS);
        if (!hService)
        {
            CloseServiceHandle(hSCM);
            return 0;
        }

        DWORD pid = 0;
        SERVICE_STATUS_PROCESS ssp;
        DWORD bytesNeeded;

        // 等待服务进入运行状态
        for (int i = 0; i < 30; i++)
        { // 最多等待30秒
            if (QueryServiceStatusEx(hService, SC_STATUS_PROCESS_INFO,
                                     (LPBYTE)&ssp, sizeof(ssp), &bytesNeeded))
            {
                if (ssp.dwCurrentState == SERVICE_RUNNING)
                {
                    pid = ssp.dwProcessId;
                    break;
                }
            }
            Sleep(1000); // 等待1秒
        }

        CloseServiceHandle(hService);
        CloseServiceHandle(hSCM);
        return pid;
    }

    // 构建完整的命令行
    std::wstring BuildCommandLine(LPCWSTR applicationPath, LPCWSTR arguments)
    {
        std::wstring commandLine;

        // 如果路径包含空格，需要引号
        if (wcschr(applicationPath, L' '))
        {
            commandLine = L"\"" + std::wstring(applicationPath) + L"\"";
        }
        else
        {
            commandLine = applicationPath;
        }

        // 添加参数
        if (arguments && wcslen(arguments) > 0)
        {
            commandLine += L" ";
            commandLine += arguments;
        }

        return commandLine;
    }

    // 主要执行函数
    BOOL LaunchAsTrustedInstaller(LPCWSTR applicationPath, LPCWSTR arguments = nullptr)
    {
        // 步骤1: 启用调试和模拟权限
        HANDLE hToken;
        if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &hToken))
        {
            return FALSE;
        }

        if (!EnablePrivilege(hToken, SE_DEBUG_PRIVILEGE) ||
            !EnablePrivilege(hToken, SE_IMPERSONATE_PRIVILEGE))
        {
            CloseHandle(hToken);
            return FALSE;
        }

        // 步骤2: 获取系统令牌 (通过 winlogon)
        DWORD winlogonPid = FindProcessByName(L"winlogon.exe");
        if (!winlogonPid)
        {
            CloseHandle(hToken);
            return FALSE;
        }

        HANDLE hWinlogon = OpenProcess(PROCESS_DUP_HANDLE | PROCESS_QUERY_INFORMATION, FALSE, winlogonPid);
        if (!hWinlogon)
        {
            CloseHandle(hToken);
            return FALSE;
        }

        HANDLE hSystemToken;
        if (!OpenProcessToken(hWinlogon, TOKEN_QUERY | TOKEN_DUPLICATE, &hSystemToken))
        {
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        if (!ImpersonateLoggedOnUser(hSystemToken))
        {
            CloseHandle(hSystemToken);
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        // 步骤3: 启动 TrustedInstaller 服务
        if (!StartTrustedInstallerService())
        {
            RevertToSelf();
            CloseHandle(hSystemToken);
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        DWORD trustedInstallerPid = WaitForTrustedInstallerService();
        if (!trustedInstallerPid)
        {
            RevertToSelf();
            CloseHandle(hSystemToken);
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        // 步骤4: 获取 TrustedInstaller 线程并模拟
        DWORD trustedInstallerTid = GetFirstThreadId(trustedInstallerPid);
        if (!trustedInstallerTid)
        {
            RevertToSelf();
            CloseHandle(hSystemToken);
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        HANDLE hThread = OpenThread(THREAD_DIRECT_IMPERSONATION, FALSE, trustedInstallerTid);
        if (!hThread || !NtImpersonateThread)
        {
            RevertToSelf();
            CloseHandle(hSystemToken);
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        SECURITY_QUALITY_OF_SERVICE sqos = {0};
        sqos.Length = sizeof(sqos);
        sqos.ImpersonationLevel = SecurityImpersonation;

        NTSTATUS status = NtImpersonateThread(GetCurrentThread(), hThread, &sqos);
        if (status != 0)
        {
            CloseHandle(hThread);
            RevertToSelf();
            CloseHandle(hSystemToken);
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        // 步骤5: 获取并复制令牌
        HANDLE hImpersonatedToken;
        if (!OpenThreadToken(GetCurrentThread(), TOKEN_ALL_ACCESS, FALSE, &hImpersonatedToken))
        {
            CloseHandle(hThread);
            RevertToSelf();
            CloseHandle(hSystemToken);
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        HANDLE hDuplicatedToken;
        if (!DuplicateTokenEx(hImpersonatedToken, MAXIMUM_ALLOWED, nullptr,
                              SecurityImpersonation, TokenImpersonation, &hDuplicatedToken))
        {
            CloseHandle(hImpersonatedToken);
            CloseHandle(hThread);
            RevertToSelf();
            CloseHandle(hSystemToken);
            CloseHandle(hWinlogon);
            CloseHandle(hToken);
            return FALSE;
        }

        // 步骤6: 使用令牌创建进程
        std::wstring commandLine = BuildCommandLine(applicationPath, arguments);

        STARTUPINFOW si = {0};
        PROCESS_INFORMATION pi = {0};
        si.cb = sizeof(si);
        si.lpDesktop = L"Winsta0\\Default";

        BOOL success = CreateProcessWithTokenW(
            hDuplicatedToken,
            LOGON_WITH_PROFILE,
            applicationPath,                         // lpApplicationName
            const_cast<LPWSTR>(commandLine.c_str()), // lpCommandLine
            CREATE_UNICODE_ENVIRONMENT,
            nullptr, // lpEnvironment
            nullptr, // lpCurrentDirectory
            &si,
            &pi);

        // 清理资源
        if (success)
        {
            CloseHandle(pi.hProcess);
            CloseHandle(pi.hThread);
        }

        CloseHandle(hDuplicatedToken);
        CloseHandle(hImpersonatedToken);
        CloseHandle(hThread);
        RevertToSelf();
        CloseHandle(hSystemToken);
        CloseHandle(hWinlogon);
        CloseHandle(hToken);

        return success;
    }
};
