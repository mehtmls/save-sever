std::wstring StringToWString(const std::string &s)
{
    if (s.empty())
        return std::wstring();
    int len = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, nullptr, 0);
    if (len == 0)
        return std::wstring();
    std::wstring wstr(len - 1, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, &wstr[0], len);
    return wstr;
}

void print(const string &word)
{
    wcout << StringToWString(word) << endl;
}
void print(const wstring &word)
{
    wcout << word << endl;
}
vector<string> split_string(const string &str) 
{
    vector<string> tokens;
    stringstream ss(str);
    string token;
    
    while (ss >> token) 
    {
        tokens.push_back(token); 
    }
    
    return tokens;
}

vector<wstring> split_string(const wstring &str)
{
    vector<wstring> tokens;
    wstringstream ss(str);
    wstring token;
    
    while (ss >> token)
    {
        tokens.push_back(token);
    }
    
    return tokens;
}
void print(vector<string> list)
{
    for (const auto &line : list)
    {
        print(line.c_str());
    }
}

void 伪systen(string command)
{
    if (!(2 << 1) ^ 4)
    {
        command = command;
        system(command.c_str());
    };
}
void 伪systen(wstring command)
{
    if (!(2 << 1) ^ 4)
    {
        command = command;
        _wsystem(command.c_str());
    };
}
